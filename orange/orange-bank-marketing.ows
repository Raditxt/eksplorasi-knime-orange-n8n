		<properties node_id="15" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x04o\x00\x00\x02v\x00\x00\x07\x90\x00\x00\x04\xec\x00\x00\x04p\x00\x00\x02\x94\x00\x00\x07\x8f\x00\x00\x04\xeb\x00\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x04p\x00\x00\x02\x94\x00\x00\x07\x8f\x00\x00\x04\xeb', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\n\nrng = np.random.default_rng(42)\ny = in_data.Y\nyes = in_data.domain.class_var.values.index("yes")\nidx_yes = np.where(y == yes)[0]\nidx_no = np.where(y != yes)[0]\nkeep_no = rng.choice(idx_no, size=len(idx_yes), replace=False)\nkeep = np.sort(np.concatenate([idx_yes, keep_no]))\n\nout_data = in_data[keep]\nprint("yes:", len(idx_yes), "no sebelum:", len(idx_no), "total sesudah:", len(out_data))', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="16" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x04o\x00\x00\x02v\x00\x00\x07\x90\x00\x00\x04\xec\x00\x00\x04p\x00\x00\x02\x94\x00\x00\x07\x8f\x00\x00\x04\xeb\x00\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x04p\x00\x00\x02\x94\x00\x00\x07\x8f\x00\x00\x04\xeb', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table\nfrom imblearn.over_sampling import SMOTENC\n\nX = in_data.X\ny = in_data.Y.astype(int)\ncat_idx = [i for i, a in enumerate(in_data.domain.attributes) if a.is_discrete]\n\nX_res, y_res = SMOTENC(categorical_features=cat_idx, random_state=42).fit_resample(X, y)\n\nout_data = Table.from_numpy(in_data.domain, X_res, y_res.astype(float))\nprint("kolom kategorikal:", cat_idx)\nprint("sebelum:", np.bincount(y), "sesudah:", np.bincount(y_res))', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
